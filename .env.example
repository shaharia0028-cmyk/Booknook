# Copy this file to .env.local and fill in the values.

# MongoDB (Better Auth stores users and sessions here)
MONGODB_URI=
MONGODB_DB=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Express server
NEXT_PUBLIC_API_URL=

# Google login (Google Cloud Console > Credentials > OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cover image upload (imgbb.com > API)
NEXT_PUBLIC_IMGBB_API_KEY=
